<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.agenda.controllers.CalendarioController"
      styleClass="calendario-container"
      spacing="0">

    <!-- Barra de navegación de mes -->
    <HBox styleClass="nav-mes-bar" alignment="CENTER_LEFT" spacing="8">
        <Button fx:id="btnMesAnterior" text="‹" styleClass="btn-nav"
                onAction="#navegarMesAnterior" />
        <Label fx:id="lblMes" text="" styleClass="mes-label" />
        <Button fx:id="btnMesSiguiente" text="›" styleClass="btn-nav"
                onAction="#navegarMesSiguiente" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Grid del calendario (construcción programática en el controlador) -->
    <GridPane fx:id="gridCalendario" styleClass="calendario-container"
              hgap="4" vgap="4" VBox.vgrow="ALWAYS">
        <padding>
            <javafx.geometry.Insets top="8" right="16" bottom="16" left="16"/>
        </padding>
    </GridPane>

</VBox>
